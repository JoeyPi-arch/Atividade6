programa {
  funcao inicio() {
    real n1, n2, n3, m
    escreva ("Vamos ver a média do aluno.\n")
    escreva ("Insira a primeira nota: ")
    leia (n1*0.3)
    escreva ("Insira a segunda nota: ")
    leia (n2*0.2)
    escreva ("Insira a terceira nota: ")
    leia (n3*0.5)
    m = (n1 + n2 + n3)
    escreva ("A sua média é de: ", m)
  }
}
